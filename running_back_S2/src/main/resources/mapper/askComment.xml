<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.korit.running_back_s2.domain.ask.AskCommentMapper">

    <resultMap id="AskCommentMap" type="com.korit.running_back_s2.domain.ask.AskComment">
        <id     property="askCommentId"            column="ask_comment_id"/>
        <result property="askId"                   column="ask_id"/>
        <result property="userId"                   column="user_id"/>
        <result property="content"                  column="content"/>
        <result property="status"                   column="status" />
        <result property="createdAt"                column="created_at" />

        <association property="user" resultMap="UserMap" />
    </resultMap>

    <resultMap id="UserMap" type="User" >
        <id property="userId" column="user_id" />
        <result property="oauthType" column="oauth_type" />
        <result property="providerId" column="provider_id" />
        <result property="email"  column="email" />
        <result property="picture" column="picture" />
        <result property="fullName" column="full_name" />
        <result property="nickname" column="nickname" />
        <result property="phoneNumber" column="phone_number" />
        <result property="gunguId" column="gungu_id" />
        <result property="address" column="address" />
        <result property="birthDate" column="birth_date" />
        <result property="gender"  column="gender" />
        <result property="totalKm" column="total_km" />
        <result property="role" column="role" />
    </resultMap>

    <insert id="insert">
        insert into
        ask_comment_tb (ask_id, user_id, content)
        values(#{askId}, #{userId}, #{content})
    </insert>

    <update id="updateCommentStatus">
        update ask_comment_tb
        set
            status = 1
        where
            ask_comment_id = #{askCommentId}
    </update>

    <select id="findAllByAskId" resultMap="AskCommentMap" >
        select
            ac.ask_comment_id,
            ac.ask_id,
            ac.user_id,
            ac.content,
            ac.status,
            ac.created_at,
            ut.role
        from
            ask_comment_tb ac
            left outer join user_tb ut on(ac.user_id = ut.user_id)
        where
            ac.ask_id = #{askId}
        order by
            ac.created_at asc
    </select>

</mapper>
